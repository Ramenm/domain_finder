# OpenAI API key (обязательно)
OPENAI_API_KEY=replace_with_your_openai_key

# Модель OpenAI (по умолчанию: gpt-4o)
OPENAI_MODEL=gpt-4o

# Базовый URL для OpenAI-совместимого API (опционально, по умолчанию: https://api.openai.com/v1)
# Можно использовать для кастомных эндпоинтов, например: https://api.openai.com/v1 или https://api.example.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Если true/1/yes — проверки делаются через RDAP (рекомендуется).
# Иначе будет использоваться библиотека python-whois.
USE_RDAP=true
