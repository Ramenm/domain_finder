# OpenAI API key (required)
OPENAI_API_KEY=replace_with_your_openai_key

# OpenAI model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Base URL for OpenAI-compatible API (optional, default: https://api.openai.com/v1)
# Can be used for custom endpoints, e.g.: https://api.openai.com/v1 or https://api.example.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# If true/1/yes — checks are performed via RDAP (recommended).
# Otherwise, the python-whois library will be used.
USE_RDAP=true
