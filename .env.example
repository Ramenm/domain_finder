# Ключ для chat01 (по умолчанию используется провайдер chat01 и модель gpt-5-thinking)
API_KEY_CHAT01=replace_with_your_chat01_key

# (Необязательно) Ключ для OpenRouter, если хотите использовать другой провайдер
API_KEY_OPENROUTER=replace_with_your_openrouter_key

# Если true/1/yes — проверки делаются через RDAP (рекомендуется).
# Иначе будет использоваться библиотека python-whois.
USE_RDAP=true
