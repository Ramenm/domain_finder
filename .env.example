OPENAI_API_KEY=replace_with_your_openai_key

# OpenAI model and endpoint
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Domain checking
USE_RDAP=true
REGISTRY_PROFILE_FILE=.domain_finder_registry_profiles.sqlite3

# HTTP / RDAP
HTTP_TIMEOUT=60.0
RDAP_TIMEOUT=10.0
MAX_CONNECTIONS=100
MAX_KEEPALIVE_CONNECTIONS=20

# Retries
MAX_RETRIES=3
RETRY_BACKOFF_MIN=1.0
RETRY_BACKOFF_MAX=3.0

# LLM concurrency
MAX_CONCURRENT_LLM_REQUESTS=8
ENABLE_STREAMING=false
